---
import BaseLayout from '../layouts/base-layout.astro';
import GlassCard from '../components/glass-card.astro';
import PixelIconGallery from '../components/pixel-icon-gallery.astro';
import AvatarGallery from '../components/avatar/avatar-gallery.astro';
import { creditGroups } from '../data/credits-data';
import { siteConfig } from '../data/site-config';
import { withBasePath } from '../utils/with-base-path';
---

<BaseLayout
  title={`Credits | ${siteConfig.name}`}
  description={`Fonts, icons and libraries used on ${siteConfig.name}'s portfolio, with their licenses.`}
>
  <article class="credits container" aria-labelledby="credits-title">
    <a class="back-link hud-text" href={withBasePath('/')}>← Home</a>
    <header class="credits-header">
      <p class="eyebrow">Hall of heroes</p>
      <h1 id="credits-title">Credits</h1>
      <p class="credits-lead">The fonts, art and code this site is built from, and the licenses they are shared under.</p>
    </header>
    {
      creditGroups.map((group) => (
        <section class="credit-group" aria-labelledby={`credits-${group.id}`}>
          <h2 id={`credits-${group.id}`}>{group.title}</h2>
          <ul class="credit-list" role="list">
            {group.entries.map((entry) => (
              <GlassCard as="li" class="credit" spotlight={false}>
                <h3>
                  {entry.url ? (
                    <a href={entry.url} target="_blank" rel="noopener noreferrer">
                      {entry.name}
                      <span class="visually-hidden"> (opens in new tab)</span>
                    </a>
                  ) : (
                    entry.name
                  )}
                </h3>
                <p class="credit-meta">
                  {entry.author} ·{' '}
                  {entry.licenseUrl ? (
                    <a href={entry.licenseUrl} target="_blank" rel="noopener noreferrer">
                      {entry.license}
                      <span class="visually-hidden"> (opens in new tab)</span>
                    </a>
                  ) : (
                    entry.license
                  )}
                </p>
                {entry.note && <p class="credit-note">{entry.note}</p>}
              </GlassCard>
            ))}
          </ul>
          {group.id === 'icons' && <PixelIconGallery />}
          {group.id === 'icons' && <AvatarGallery />}
        </section>
      ))
    }
  </article>
</BaseLayout>

<style>
  .credits {
    display: grid;
    gap: var(--space-7);
    padding-block: var(--space-7) var(--space-section);
  }

  .back-link {
    width: fit-content;
    font-size: var(--text-sm);
  }

  .credits-header {
    display: grid;
    gap: var(--space-4);
  }

  h1 {
    font-size: clamp(2.25rem, 4vw + 1rem, 4rem);
  }

  .credits-lead {
    max-width: 40rem;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  .credit-group {
    display: grid;
    gap: var(--space-5);
  }

  .credit-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-5);
  }

  .credit {
    display: grid;
    align-content: start;
    gap: var(--space-2);
  }

  .credit-meta {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .credit-note {
    color: var(--color-text-muted);
  }
</style>
