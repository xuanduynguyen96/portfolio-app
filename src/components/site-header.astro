---
import { siteConfig } from '../data/site-config';
import HeaderControls from './header-controls.astro';
import { withBasePath } from '../utils/with-base-path';

const initials = siteConfig.name
  .split(/\s+/)
  .map((word) => word.charAt(0).toUpperCase())
  .join('');

const navItems = [
  { label: 'About', href: withBasePath('/#about') },
  { label: 'Skills', href: withBasePath('/#skills') },
  { label: 'Projects', href: withBasePath('/#projects') },
  { label: 'Experience', href: withBasePath('/#experience') },
  { label: 'Contact', href: withBasePath('/#contact') },
  { label: 'Speedrun', href: withBasePath('/speedrun/') },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a class="logo pixel-frame" href={withBasePath('/')} aria-label="Home">{initials}</a>
    <HeaderControls />
    <nav id="site-nav" class="site-nav" aria-label="Primary" data-menu>
      <ul role="list">
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} data-caret>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  import '../scripts/mobile-menu';
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: var(--color-header-bg);
    border-bottom: var(--pixel-thin) solid var(--color-border-strong);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
    min-height: 4rem;
  }

  /* Crest: initials in the heading font inside a pixel frame. */
  .logo {
    display: grid;
    place-items: center;
    min-width: 2.75rem;
    height: 2.75rem;
    margin-inline-end: auto;
    padding-inline: var(--space-2);
    background: var(--color-surface);
    color: var(--color-accent-primary);
    font-family: var(--font-heading);
    font-size: 1.25rem;
    line-height: 1;
    text-decoration: none;
  }

  .logo:hover {
    --frame-color: var(--color-frame-hover);
  }

  .site-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-5);
  }

  .site-nav a {
    position: relative;
    display: inline-block;
    padding-block: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    text-decoration: none;
    transition: color var(--duration-fast) ease-out;
  }

  .site-nav a::after {
    content: '';
    position: absolute;
    inset: auto 0 0.25rem;
    height: var(--pixel-thin);
    background: var(--color-accent-primary);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-base) steps(4, end);
  }

  .site-nav a:hover,
  .site-nav a:focus-visible {
    color: var(--color-text);
  }

  .site-nav a:hover::after,
  .site-nav a:focus-visible::after {
    transform: scaleX(1);
  }

  /* html[data-menu-enhanced] is set before paint by base-layout (no-JS: nav always visible). */
  @media (max-width: 47.99rem) {
    :global(html[data-menu-enhanced]) .site-nav {
      display: none;
      flex-basis: 100%;
      padding-bottom: var(--space-4);
    }

    :global(html[data-menu-enhanced]) .site-nav[data-open] {
      display: block;
    }

    :global(html[data-menu-enhanced]) .site-nav ul {
      flex-direction: column;
    }
  }
</style>
