---
import SectionHeading from '../section-heading.astro';
import { experienceEntries } from '../../data/experience-data';
import { formatDateRange } from '../../utils/format-date-range';
---

<section id="experience" class="section" aria-labelledby="experience-title">
  <div class="container">
    <SectionHeading index={4} label="Experience" title="Where I've shipped" id="experience-title" />
    <ol class="timeline" role="list">
      {
        experienceEntries.map((entry) => (
          <li class="timeline-item" data-reveal>
            <p class="timeline-date mono">
              <time datetime={entry.start}>{formatDateRange(entry.start, entry.end)}</time>
            </p>
            <h3>
              {entry.role} <span class="timeline-org">@ {entry.org}</span>
            </h3>
            <p class="timeline-summary">{entry.summary}</p>
            <ul class="timeline-highlights">
              {entry.highlights.map((highlight) => <li>{highlight}</li>)}
            </ul>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .timeline {
    position: relative;
    display: grid;
    gap: var(--space-7);
    padding-left: var(--space-6);
    border-left: 1px solid var(--color-border-glow);
  }

  .timeline-item {
    position: relative;
    display: grid;
    gap: var(--space-2);
  }

  .timeline-item::before {
    content: '';
    position: absolute;
    top: 0.45rem;
    left: calc(-1 * var(--space-6) - 0.375rem);
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: var(--color-bg);
    border: 2px solid var(--color-accent-cyan);
    box-shadow: var(--shadow-glow-cyan);
  }

  .timeline-date {
    font-size: var(--text-sm);
    color: var(--color-accent-cyan);
  }

  .timeline-org {
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .timeline-summary,
  .timeline-highlights {
    color: var(--color-text-muted);
  }

  .timeline-highlights {
    padding-left: var(--space-5);
  }

  .timeline-highlights li::marker {
    color: var(--color-accent-magenta);
  }
</style>
