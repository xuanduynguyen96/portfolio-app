---
import { siteConfig } from '../data/site-config';
import { withBasePath } from '../utils/with-base-path';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <p>© {year} {siteConfig.name}</p>
    <p class="hud-text footer-meta">
      <a href={withBasePath('/changelog/')}>Changelog</a> · <a href={withBasePath('/credits/')}>Credits</a> · Built with Astro + GSAP · Hosted on GitHub Pages
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: var(--pixel-thin) solid var(--color-border-strong);
    padding-block: var(--space-6);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .footer-meta {
    font-size: var(--text-hud);
    letter-spacing: var(--tracking-hud);
  }
</style>
