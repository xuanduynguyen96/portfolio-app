---
import GlassCard from '../glass-card.astro';
import QuestTierBadge from './quest-tier-badge.astro';
import { xpRules, type EvidenceType } from '../../data/xp-rules';
import { formatMetricValue } from '../../utils/career-rpg/format-metric';
import type { ScoredQuest } from '../../utils/career-rpg/career-types';

interface Props {
  quest: ScoredQuest;
}

const { quest } = Astro.props;
const heading = quest.isBoss ? 'Boss Battle' : 'Quest Log';
const evidenceLabel: Record<EvidenceType, string> = {
  repo: 'Source code',
  demo: 'Live demo',
  figma: 'Design file',
  article: 'Write-up',
  other: 'Link',
};
const { minBodyWords, minUniqueWords } = xpRules.quest;
const statusNote =
  quest.status === 'case-study'
    ? 'case study bonus'
    : !quest.body.trim()
      ? 'from repo facts'
      : quest.wordCount < minBodyWords
        ? `case study has ${quest.wordCount} of ${minBodyWords} words for its bonus`
        : `case study has ${quest.uniqueWordCount} of ${minUniqueWords} distinct words for its bonus`;
---

<section class="quest-panel" aria-labelledby="quest-panel-title">
  <GlassCard class:list={['quest-card', { 'quest-card--boss': quest.isBoss }]}>
    <header class="quest-header">
      <h2 id="quest-panel-title" class="h2-compact">{heading}</h2>
      <QuestTierBadge difficulty={quest.difficulty} isBoss={quest.isBoss} />
    </header>
    <p class="quest-xp hud-text">
      {`+${Math.round(quest.xp)} XP earned · ${statusNote}`}
    </p>

    {
      quest.obstacles.length > 0 && (
        <div class="quest-block">
          <h3 class="quest-label hud-text">Obstacles</h3>
          <ul class="obstacles" role="list" aria-label="Obstacles">
            {quest.obstacles.map((obstacle) => <li>{obstacle}</li>)}
          </ul>
        </div>
      )
    }

    {
      quest.metrics.length + quest.repoMetrics.length > 0 && (
        <div class="quest-block">
          <h3 class="quest-label hud-text">Results</h3>
          <dl class="metrics">
            {[...quest.metrics, ...quest.repoMetrics].map((metric) => (
              <div class="metric">
                <dt>{metric.label}</dt>
                <dd class="metric-value">{formatMetricValue(metric)}</dd>
              </div>
            ))}
          </dl>
        </div>
      )
    }

    {
      quest.evidence.length > 0 && (
        <div class="quest-block">
          <h3 class="quest-label hud-text">Evidence</h3>
          <ul class="evidence" role="list" aria-label="Evidence">
            {quest.evidence.map((item) => (
              <li>
                <a href={item.url} target="_blank" rel="noopener noreferrer" class="hud-text">
                  {evidenceLabel[item.type]} ↗<span class="visually-hidden"> (opens in new tab)</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </GlassCard>
</section>

<style>
  .quest-card {
    display: grid;
    gap: var(--space-5);
    max-width: 44rem;
  }

  /* Crimson frame via --frame-color; glow as filter so the box-shadow pixel frame survives. */
  .quest-card--boss,
  .quest-card--boss:hover {
    --frame-color: var(--color-accent-secondary);
  }

  .quest-card--boss {
    filter: drop-shadow(0 0 12px var(--color-glow-secondary));
  }

  .quest-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .quest-xp {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .quest-block {
    display: grid;
    gap: var(--space-3);
  }

  .quest-label {
    color: var(--color-accent-primary);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-hud);
    text-transform: uppercase;
  }

  .obstacles {
    display: grid;
    gap: var(--space-2);
    color: var(--color-text-muted);
  }

  /* Bullet = one pixel square, crimson for bosses */
  .obstacles li {
    position: relative;
    padding-left: var(--space-5);
  }

  .obstacles li::before {
    content: '';
    position: absolute;
    top: calc(0.825em - var(--pixel-thin));
    left: var(--space-1);
    inline-size: var(--pixel);
    block-size: var(--pixel);
    background: var(--color-accent-primary);
  }

  .quest-card--boss .obstacles li::before {
    background: var(--color-accent-secondary);
  }

  .metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 10rem), 1fr));
    gap: var(--space-4);
  }

  .metric {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--space-1);
  }

  dt {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .metric-value {
    color: var(--color-text);
    font-family: var(--font-hud);
    font-size: var(--text-h3);
    font-weight: 700;
  }

  .evidence {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    font-size: var(--text-sm);
  }
</style>
