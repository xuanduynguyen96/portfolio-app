---
import GlassCard from '../glass-card.astro';
import PixelIcon from '../pixel-icon.astro';
import XpProgressBar from './xp-progress-bar.astro';
import type { Completeness } from '../../utils/career-rpg/career-types';

interface Props {
  completeness: Completeness;
}

const { completeness } = Astro.props;
const { percent, missing } = completeness;
const passed = completeness.items.length - missing.length;
---

<GlassCard class="hud" data-reveal>
  <div class="hud-head">
    <PixelIcon name="evidence" size={24} />
    <h3 class="hud-title">Profile HUD</h3>
  </div>
  <XpProgressBar
    id="hud-completeness"
    label="Profile completeness"
    value={percent}
    max={100}
    valueText={`${percent}% · ${passed} / ${completeness.items.length} checks`}
  />
  {
    missing.length > 0 ? (
      <details class="hud-missing">
        <summary class="hud-text">{missing.length} {missing.length === 1 ? 'item' : 'items'} missing</summary>
        <ul role="list">
          {missing.map((item) => (
            <li>{item.label}</li>
          ))}
        </ul>
      </details>
    ) : (
      <p class="hud-done hud-text">All checks passed</p>
    )
  }
</GlassCard>

<style>
  .hud {
    display: grid;
    gap: var(--space-4);
  }

  .hud-head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-accent-primary); /* icon ink */
  }

  .hud-title {
    color: var(--color-text);
    font-size: var(--text-lg);
  }

  /* >=44px target; a pixel triangle replaces the native disclosure marker. */
  .hud-missing summary {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    width: fit-content;
    padding-block: var(--space-3);
    color: var(--color-accent-primary);
    font-size: var(--text-sm);
    list-style: none;
    cursor: pointer;
  }

  .hud-missing summary::-webkit-details-marker {
    display: none;
  }

  .hud-missing summary::before {
    content: '';
    inline-size: calc(1.5 * var(--pixel));
    block-size: calc(2.5 * var(--pixel));
    background: currentColor;
    clip-path: polygon(0 0, 33% 0, 33% 20%, 67% 20%, 67% 40%, 100% 40%, 100% 60%, 67% 60%, 67% 80%, 33% 80%, 33% 100%, 0 100%);
  }

  .hud-missing[open] summary::before {
    rotate: 90deg;
  }

  .hud-missing ul {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  /* Bullet = one pixel square */
  .hud-missing li {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding-left: var(--space-2);
  }

  .hud-missing li::before {
    content: '';
    flex: none;
    inline-size: var(--pixel);
    block-size: var(--pixel);
    background: var(--color-accent-secondary);
    translate: 0 calc(-1 * var(--pixel-thin));
  }

  .hud-done {
    color: var(--color-accent-primary);
    font-size: var(--text-sm);
  }
</style>
