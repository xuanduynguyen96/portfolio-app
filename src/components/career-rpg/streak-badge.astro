---
import PixelIcon from '../pixel-icon.astro';
import type { StreakInfo } from '../../utils/career-rpg/career-types';
import { formatEntryDate } from '../../utils/format-date-range';

interface Props {
  streak: StreakInfo;
  /** GitHub profile: where the activity behind the streak lives. */
  href: string;
}

const { streak, href } = Astro.props;
const weeks = (count: number) => `${count}-week`;
const text =
  streak.current > 0
    ? `${weeks(streak.current)} streak · best ${streak.longest}`
    : streak.lastActiveWeek
      ? `Streak paused · last active week of ${formatEntryDate(streak.lastActiveWeek)}`
      : 'No GitHub activity yet';
---

<a class="streak-badge pixel-frame hud-text" href={href} target="_blank" rel="noopener noreferrer" data-streak={streak.current}>
  <span class="streak-flame"><PixelIcon name="streak" /></span>{text}<span class="visually-hidden"> (GitHub profile, opens in new tab)</span>
</a>

<style>
  /* Square framed pill, >=44px tall. Flame lit (crimson) while the streak runs, ash-grey when paused. */
  .streak-badge {
    --frame-color: var(--color-border-strong);
    --frame-drop: transparent;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    width: fit-content;
    min-height: 2.75rem;
    margin: var(--pixel-thin);
    padding-inline: var(--space-3) var(--space-4);
    background: var(--color-bg);
    color: var(--color-text);
    font-size: var(--text-hud);
    letter-spacing: 0.02em;
    text-decoration: none;
  }

  .streak-badge:hover {
    --frame-color: var(--color-frame-hover);
  }

  .streak-flame {
    display: inline-flex;
    color: var(--color-text-muted);
  }

  .streak-badge:not([data-streak='0']) .streak-flame {
    color: var(--color-accent-secondary);
  }
</style>
