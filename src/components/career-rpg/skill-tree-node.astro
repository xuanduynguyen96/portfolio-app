---
import PixelIcon from '../pixel-icon.astro';
import { xpRules } from '../../data/xp-rules';
import { skillRootIcon } from '../../data/pixel-icon-map';
import type { SkillTreeNode } from '../../utils/career-rpg/career-types';
import { withBasePath } from '../../utils/with-base-path';

interface Props {
  node: SkillTreeNode;
  /** Quest id -> title, for "Proven in" links. */
  questTitles: Record<string, string>;
  /** Roots render their label as a heading. */
  isRoot?: boolean;
}

const { node, questTitles, isRoot = false } = Astro.props;
const maxLevel = xpRules.skillEvidence.levelThresholds.length;
const pips = Array.from({ length: maxLevel }, (_, index) => index < node.level);
const isLocked = node.level === 0;
const Label = isRoot ? 'h3' : 'span';
const shortUrl = (url: string) => {
  const { hostname, pathname } = new URL(url);
  return `${hostname}${pathname.replace(/\/$/, '')}`;
};
---

<div class:list={['skill-node', { 'skill-node--root': isRoot, 'skill-node--locked': isLocked }]}>
  {isRoot && <PixelIcon name={skillRootIcon(node.id)} size={24} />}
  <Label class="skill-node-label">
    {node.label}<span class="visually-hidden">, level {node.level} of {maxLevel}{isLocked && ' (locked)'}</span>
  </Label>
  <span class="skill-pips" aria-hidden="true">
    {isLocked && <PixelIcon name="locked" />}
    {pips.map((on) => <span class:list={['pip', { 'pip--on': on }]} />)}
  </span>
</div>
{
  node.questIds.length > 0 && (
    <p class="skill-quests">
      Proven in{' '}
      {node.questIds.map((id, index) => (
        <>
          {index > 0 && ', '}
          <a href={withBasePath(`/projects/${id}/`)}>{questTitles[id] ?? id}</a>
        </>
      ))}
    </p>
  )
}
{
  node.evidence.length > 0 && (
    <details class="skill-evidence pixel-details">
      <summary class="hud-text">Evidence ({node.evidence.length})</summary>
      <ul role="list">
        {node.evidence.map((url) => (
          <li>
            <a href={url} target="_blank" rel="noopener noreferrer">
              {shortUrl(url)}
              <span class="visually-hidden"> (opens in new tab)</span>
            </a>
          </li>
        ))}
      </ul>
    </details>
  )
}
{
  node.children.length > 0 && (
    <ul class="skill-branch" role="list" aria-label={`${node.label} sub-skills`}>
      {node.children.map((child) => (
        <li>
          <Astro.self node={child} questTitles={questTitles} />
        </li>
      ))}
    </ul>
  )
}

<style>
  .skill-node {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }

  .skill-node-label {
    margin-inline-end: auto;
    color: var(--color-text);
    font-size: var(--text-sm);
  }

  .skill-node--root {
    color: var(--color-accent-primary); /* root icon ink */
  }

  .skill-node--root .skill-node-label {
    color: var(--color-accent-primary);
    font-family: var(--font-hud);
    font-size: var(--text-base);
    letter-spacing: var(--tracking-hud);
    text-transform: uppercase;
  }

  .skill-node--locked,
  .skill-node--locked .skill-node-label {
    color: var(--color-text-muted);
  }

  .skill-pips {
    display: inline-flex;
    align-items: center;
    gap: var(--pixel);
    color: var(--color-text-muted); /* lock icon */
  }

  /* Gem pip: 4x4 art px with notched corners. Off = hollow gem, on = solid gold (shape differs, not just hue). */
  .pip {
    inline-size: var(--pip-size);
    block-size: var(--pip-size);
    background:
      linear-gradient(var(--color-surface), var(--color-surface)) center / 50% 50% no-repeat,
      var(--color-border-strong);
    clip-path: polygon(25% 0, 75% 0, 75% 25%, 100% 25%, 100% 75%, 75% 75%, 75% 100%, 25% 100%, 25% 75%, 0 75%, 0 25%, 25% 25%);
  }

  .pip--on { background: var(--color-accent-primary); }

  .skill-quests,
  .skill-evidence {
    color: var(--color-text-muted);
    font-size: var(--text-hud);
  }

  .skill-evidence ul {
    display: grid;
    gap: var(--space-2);
    padding-bottom: var(--space-2);
  }

  .skill-evidence a {
    overflow-wrap: anywhere;
  }

  /* Pixel-dashed connectors (decorative; nested lists carry structure). Each li draws its trunk segment. */
  .skill-branch {
    --dash-v: repeating-linear-gradient(180deg, var(--color-border-accent) 0 var(--pixel), transparent 0 calc(2 * var(--pixel)));
    display: grid;
    margin-top: var(--space-3);
    margin-left: var(--space-1);
  }

  .skill-branch > li {
    position: relative;
    padding-left: var(--space-5);
    padding-bottom: var(--space-2);
    background: var(--dash-v) left top / var(--pixel-thin) 100% no-repeat;
  }

  .skill-branch > li:last-child {
    padding-bottom: 0;
    background-size: var(--pixel-thin) calc(0.8em + var(--pixel-thin)); /* stop at elbow */
  }

  .skill-branch > li::before {
    content: '';
    position: absolute;
    top: 0.8em;
    left: 0;
    inline-size: var(--space-4);
    block-size: var(--pixel-thin);
    background: repeating-linear-gradient(90deg, var(--color-border-accent) 0 var(--pixel), transparent 0 calc(2 * var(--pixel)));
  }
</style>
