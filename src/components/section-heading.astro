---
import { toRomanNumeral } from '../utils/to-roman-numeral';

interface Props {
  /** Section number shown as a chapter in the eyebrow, e.g. 1 -> "Ch. I · " (hidden from screen readers) */
  index: number;
  label: string;
  title: string;
  /** id for the h2, referenced by the section's aria-labelledby */
  id: string;
}

const { index, label, title, id } = Astro.props;
const chapter = toRomanNumeral(index);
---

<div class="section-heading" data-reveal>
  <p class="eyebrow"><span aria-hidden="true">Ch. {chapter} · </span>{label}</p>
  <h2 id={id}>{title}</h2>
</div>

<style>
  .section-heading {
    display: grid;
    gap: var(--space-3);
    margin-bottom: var(--space-7);
  }
</style>
