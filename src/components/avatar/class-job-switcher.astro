---
// Class/job picker for the character sheet. Anyone may choose any of the 10 looks; the GitHub-derived
// look is only the default ("GitHub pick") and gear always comes from the GitHub stats.
// Server-rendered, hidden until its script binds (data-ready), so no JS = no dead control.
import SwitcherOption from './switcher-option.astro';
import { ARCHETYPE_IDS } from '../../data/character-class-rules';
import { ARCHETYPE_LABELS, CLASS_IDS, CLASS_NAMES, JOBS } from '../../data/character-job-rules';
import { lookTitle, suggestionLine } from '../../utils/avatar/class-labels';
import { defaultLook, lookKey, sameLook } from '../../utils/avatar/class-looks';
import type { CharacterProfile } from '../../utils/github-character/character-types';

interface Props {
  character: CharacterProfile;
}

const { character } = Astro.props;
const pick = defaultLook(character);
const gear = JSON.stringify(character.gear.map(({ slot, tier }) => ({ slot, tier })));
const combatClasses = CLASS_IDS.filter((id) => id !== 'adventurer');
---

<details class="look-switcher pixel-details" data-look data-default-look={lookKey(pick)} data-gear={gear}>
  <summary class="hud-text">Choose class &amp; job</summary>
  <div class="switcher-body">
    <p class="switcher-pick">{suggestionLine(lookTitle(pick))}</p>
    <p class="switcher-note">
      Class and job change the sprite and name. Gear is earned from the public GitHub stats and shows on any class.
    </p>
    <fieldset class="switcher-group">
      <legend class="hud-text">Class</legend>
      <div class="switcher-options">
        {CLASS_IDS.map((id) => (
          <SwitcherOption name="switcher-class" value={id} label={CLASS_NAMES[id]} isPick={id === pick.classId} />
        ))}
      </div>
    </fieldset>
    {combatClasses.map((classId) => (
      <fieldset class="switcher-group" data-look-jobs={classId} hidden={classId !== pick.classId}>
        <legend class="hud-text">Job</legend>
        <div class="switcher-options">
          {ARCHETYPE_IDS.map((motif) => (
            <SwitcherOption
              name={`switcher-job-${classId}`}
              value={motif}
              label={JOBS[classId][motif].name}
              hint={ARCHETYPE_LABELS[motif]}
              isPick={sameLook({ classId, motif }, pick)}
            />
          ))}
        </div>
      </fieldset>
    ))}
    <p class="switcher-note" data-look-jobs="adventurer" hidden={pick.classId !== 'adventurer'}>
      Adventurer has no job: too little public signal for a focus.
    </p>
    <button type="button" class="switcher-reset pixel-frame hud-text" data-look-reset disabled>Reset to GitHub pick</button>
    <p class="switcher-status" role="status" data-look-status></p>
  </div>
</details>

<script>
  import '../../scripts/class-job-switcher';
</script>

<style>
  /* Enhancement only: hidden (same box) until the script binds; gone without JS. */
  .look-switcher:not([data-ready]) {
    visibility: hidden;
  }

  @media (scripting: none) {
    .look-switcher {
      display: none;
    }
  }

  .switcher-body {
    display: grid;
    gap: var(--space-3);
    padding-block: var(--space-2);
  }

  .switcher-pick {
    color: var(--color-accent-primary);
    font-weight: 600;
  }

  .switcher-note {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .switcher-group {
    display: grid;
    gap: var(--space-2);
    min-inline-size: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .switcher-group[hidden],
  .switcher-note[hidden] {
    display: none;
  }

  .switcher-group legend {
    padding: 0;
    color: var(--color-text-muted);
    font-size: var(--text-hud);
    letter-spacing: var(--tracking-hud);
  }

  .switcher-options {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 8.5rem), 1fr));
    gap: var(--space-2);
  }

  .switcher-reset {
    justify-self: start;
    min-block-size: 2.75rem;
    margin: var(--pixel-thin);
    padding: var(--space-2) var(--space-4);
    background: var(--color-surface);
    border: 0;
    color: var(--color-accent-primary);
    cursor: pointer;
  }

  .switcher-reset:hover:not(:disabled) {
    --frame-color: var(--color-frame-hover);
  }

  .switcher-reset:disabled {
    color: var(--color-text-muted);
    cursor: not-allowed;
  }

  .switcher-status {
    min-block-size: 1.5em; /* reserved: the message appears without moving the panel */
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
</style>
