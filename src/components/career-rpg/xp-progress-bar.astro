---
import PixelIcon from '../pixel-icon.astro';
import type { PixelIconName } from '../../data/pixel-icons';

interface Props {
  /** Unique per page; `${id}-label` names the bar via aria-labelledby (works in every AT/tool, unlike <label> on <progress>). */
  id: string;
  label: string;
  value: number;
  max: number;
  /** Human-readable value, e.g. "450 / 520 XP". */
  valueText: string;
  /** Decorative icon left of the label (outside the label element, so the accessible name is unchanged). */
  icon?: PixelIconName;
}

const { id, label, value, max, valueText, icon } = Astro.props;
const safeMax = max > 0 ? max : 1;
const safeValue = Math.min(safeMax, Math.max(0, value));
---

<div class="xp-bar">
  <div class="xp-bar-row">
    <span class="xp-bar-name">
      {icon && <PixelIcon name={icon} />}
      <span id={`${id}-label`} class="xp-bar-label hud-text">{label}</span>
    </span>
    <span class="xp-bar-value hud-text" aria-hidden="true">{valueText}</span>
  </div>
  <progress
    id={id}
    class="pixel-frame"
    max={safeMax}
    value={safeValue}
    aria-labelledby={`${id}-label`}
    aria-valuetext={valueText}
  >{valueText}</progress>
</div>

<style>
  .xp-bar {
    display: grid;
    gap: var(--space-2);
  }

  .xp-bar-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    font-size: var(--text-hud);
    letter-spacing: 0.02em;
  }

  .xp-bar-name {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-accent-primary); /* icon ink */
  }

  .xp-bar-label {
    color: var(--color-text);
  }

  .xp-bar-value {
    color: var(--color-text-muted);
  }

  /* Framed track (thin pixel frame sits outside the box, so inset by it) + static gold segments. */
  progress {
    --frame-color: var(--color-border-strong);
    --frame-drop: transparent;
    --bar-fill: repeating-linear-gradient(
      90deg,
      var(--color-accent-primary) 0 var(--seg),
      transparent var(--seg) calc(var(--seg) + var(--pixel-thin))
    );
    appearance: none;
    inline-size: calc(100% - 2 * var(--pixel-thin));
    block-size: var(--bar-height);
    margin: var(--pixel-thin);
    border: 0;
    background: var(--color-bg);
  }

  progress::-webkit-progress-bar {
    background: var(--color-bg);
  }

  progress::-webkit-progress-value {
    background: var(--bar-fill);
  }

  progress::-moz-progress-bar {
    background: var(--bar-fill);
  }
</style>
