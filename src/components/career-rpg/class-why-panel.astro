---
// "Why Warrior?": the ranked repo signals behind the class (domain) and job, so the result is explainable.
import { DOMAIN_LABELS } from '../../data/character-job-rules';
import type { CharacterProfile } from '../../utils/github-character/character-types';

interface Props {
  character: CharacterProfile;
}

const { character } = Astro.props;
const { primary } = character;
const lists = [
  { label: `Evidence for ${character.className}`, signals: character.signals },
  { label: `Evidence for ${character.jobName ?? ''}`, signals: character.jobSignals },
].filter((list) => list.signals.length > 0);
const points = (value: number) => `+${value.toFixed(2)}`;
---

<details class="why pixel-details">
  <summary class="hud-text">Why {character.className}?</summary>
  {
    primary === null ? (
      <p class="why-text">Not enough public signal yet: a class appears once a few public repos show a clear focus.</p>
    ) : (
      <div class="why-body">
        <p class="why-text">
          Strongest domain: <strong>{DOMAIN_LABELS[primary]}</strong>
          {character.jobName && (
            <>
              , job <strong>{character.jobName}</strong>
            </>
          )}
          .
        </p>
        {lists.map((list) => (
          <ul class="why-signals" role="list" aria-label={list.label}>
            {list.signals.map((signal) => (
              <li>
                <span class="why-repo">{signal.repo}</span> {signal.reason} <span class="why-points hud-text">{points(signal.points)}</span>
              </li>
            ))}
          </ul>
        ))}
      </div>
    )
  }
</details>

<style>
  .why-body {
    display: grid;
    gap: var(--space-3);
  }

  .why-text,
  .why-signals {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .why-signals {
    display: grid;
    gap: var(--space-2);
  }

  .why-repo {
    color: var(--color-text);
    font-weight: 600;
  }

  .why-points {
    color: var(--color-accent-primary);
    white-space: nowrap;
  }
</style>
