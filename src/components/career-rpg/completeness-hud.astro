---
import GlassCard from '../glass-card.astro';
import XpProgressBar from './xp-progress-bar.astro';
import type { Completeness } from '../../utils/career-rpg/career-types';

interface Props {
  completeness: Completeness;
}

const { completeness } = Astro.props;
const { percent, missing } = completeness;
const passed = completeness.items.length - missing.length;
---

<GlassCard class="hud" data-reveal>
  <h3 class="hud-title">Profile HUD</h3>
  <XpProgressBar
    id="hud-completeness"
    label="Profile completeness"
    value={percent}
    max={100}
    valueText={`${percent}% · ${passed} / ${completeness.items.length} checks`}
  />
  {
    missing.length > 0 ? (
      <details class="hud-missing">
        <summary class="mono">{missing.length} {missing.length === 1 ? 'item' : 'items'} missing</summary>
        <ul role="list">
          {missing.map((item) => (
            <li>{item.label}</li>
          ))}
        </ul>
      </details>
    ) : (
      <p class="hud-done mono">All checks passed</p>
    )
  }
</GlassCard>

<style>
  .hud {
    display: grid;
    gap: var(--space-4);
  }

  .hud-title {
    font-size: var(--text-lg);
  }

  .hud-missing summary {
    width: fit-content;
    padding-block: var(--space-3); /* >=44px target, keeps the native disclosure marker */
    color: var(--color-accent-cyan);
    font-size: var(--text-sm);
    cursor: pointer;
  }

  .hud-missing ul {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-2);
    padding-left: var(--space-5);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    list-style: square;
  }

  .hud-done {
    color: var(--color-accent-cyan);
    font-size: var(--text-sm);
  }
</style>
