---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'> & {
  href: string;
  variant?: 'primary' | 'ghost';
  /** Opens in a new tab with safe rel attributes. */
  external?: boolean;
};

const { href, variant = 'primary', external = false, class: className, ...rest } = Astro.props;
const externalAttrs = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

<a
  href={href}
  class:list={['neon-button', 'pixel-frame', `neon-button--${variant}`, className]}
  data-caret={variant === 'primary' ? '' : undefined}
  {...externalAttrs}
  {...rest}
>
  <slot />
</a>

<style>
  /* Game-menu button: pixel frame (effects.css) + drop shadow that "presses" on :active. */
  .neon-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    margin: var(--pixel-thin);
    padding: var(--space-2) var(--space-5);
    font-family: var(--font-hud);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: var(--tracking-hud);
    text-decoration: none;
    transition:
      transform var(--duration-fast) steps(2, end),
      background-color var(--duration-base) var(--ease-out-expo);
  }

  .neon-button[data-caret] {
    --caret-offset: var(--space-2);
  }

  .neon-button:hover {
    transform: translateY(calc(-1 * var(--pixel-thin)));
  }

  .neon-button:active {
    --frame-drop: transparent;
    transform: translateY(var(--pixel-thin));
  }

  .neon-button--primary {
    --frame-color: var(--color-frame);
    background: var(--color-accent-primary);
    color: var(--color-text-on-accent);
  }

  .neon-button--primary:hover {
    --frame-color: var(--color-accent-secondary);
  }

  .neon-button--ghost {
    background: var(--color-surface);
    color: var(--color-text);
  }

  .neon-button--ghost:hover {
    --frame-color: var(--color-frame-hover);
    background: var(--color-surface-hover);
  }
</style>
