---
import { getCollection } from 'astro:content';
import SectionHeading from '../section-heading.astro';
import ProjectCard from '../project-card.astro';
import { loadCareerState } from '../../utils/career-rpg/load-career-state';

// Cards = public repos picked as quests, in quest order (boss, featured, order, title: see sortQuests).
const { quests } = await loadCareerState();
const overrides = new Map((await getCollection('projects')).map((entry) => [entry.id, entry.data]));
---

<section id="projects" class="section" aria-labelledby="projects-title">
  <div class="container">
    <SectionHeading index={4} label="Projects" title="Selected work" id="projects-title" />
    <div class="projects-grid">
      {
        quests.map((quest) => (
          <ProjectCard quest={quest} cover={overrides.get(quest.id)?.cover} coverAlt={overrides.get(quest.id)?.coverAlt} />
        ))
      }
    </div>
  </div>
</section>

<style>
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-5);
  }

  /* Boss battle spans two columns once two fit. */
  @media (min-width: 56rem) {
    .projects-grid > :global([data-boss]) {
      grid-column: span 2;
    }
  }
</style>
