---
import { getCollection } from 'astro:content';
import SectionHeading from '../section-heading.astro';
import ProjectCard from '../project-card.astro';
import { sortProjects } from '../../utils/sort-projects';

const projects = sortProjects(await getCollection('projects'));
---

<section id="projects" class="section" aria-labelledby="projects-title">
  <div class="container">
    <SectionHeading index={3} label="Projects" title="Selected work" id="projects-title" />
    <div class="projects-grid">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </div>
</section>

<style>
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-5);
  }
</style>
