---
import SectionHeading from '../section-heading.astro';
import GlassCard from '../glass-card.astro';
import XpProgressBar from '../career-rpg/xp-progress-bar.astro';
import StreakBadge from '../career-rpg/streak-badge.astro';
import CompletenessHud from '../career-rpg/completeness-hud.astro';
import PixelIcon from '../pixel-icon.astro';
import { attributeIcons } from '../../data/pixel-icon-map';
import { loadCareerState } from '../../utils/career-rpg/load-career-state';

const { level, attributes, streak, completeness } = await loadCareerState();
const { nextLevelXp, totalXp } = level;
const fmt = (xp: number) => xp.toLocaleString('en');
---

<section id="character" class="section" aria-labelledby="character-title">
  <div class="container">
    <SectionHeading index={2} label="Character" title="Character sheet" id="character-title" />
    <div class="character-grid">
      <GlassCard class="identity" data-reveal>
        <div class="identity-head">
          <span class="crest pixel-frame"><PixelIcon name="level" size={48} /></span>
          <div class="identity-name">
            <p class="eyebrow">Level {level.level}</p>
            <h3 class="char-title">{level.title}</h3>
          </div>
        </div>
        <p class="char-xp-row">
          <PixelIcon name="xp" />
          <span class="char-xp hud-text">{fmt(totalXp)} XP</span>
        </p>
        <XpProgressBar
          id="xp-next-level"
          label={nextLevelXp === null ? 'Max level reached' : `Progress to level ${level.level + 1}`}
          value={level.progress}
          max={1}
          valueText={nextLevelXp === null ? `${fmt(totalXp)} XP` : `${fmt(totalXp)} / ${fmt(nextLevelXp)} XP`}
        />
        <StreakBadge streak={streak} />
      </GlassCard>

      <GlassCard class="attributes" data-reveal>
        <h3 class="card-title">Attributes</h3>
        <ul class="attribute-list" role="list" aria-label="Attributes">
          {
            attributes.map((attribute) => (
              <li>
                <XpProgressBar
                  id={`attr-${attribute.id}`}
                  label={attribute.label}
                  value={attribute.xp}
                  max={attribute.cap}
                  valueText={`${fmt(attribute.xp)} / ${fmt(attribute.cap)} XP`}
                  icon={attributeIcons[attribute.id]}
                />
              </li>
            ))
          }
        </ul>
      </GlassCard>

      <CompletenessHud completeness={completeness} />
    </div>
    <p class="character-note">
      XP is computed when the site is built, from evidence only: case studies that meet a word minimum, links no other
      entry already claimed, and caps with diminishing returns. No number here is typed in by hand.
    </p>
  </div>
</section>

<style>
  .character-grid {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 56rem) {
    .character-grid {
      grid-template-columns: 1fr 1fr;
    }

    .character-grid > :global(.hud) {
      grid-column: 1 / -1;
    }
  }

  .identity,
  .attributes {
    display: grid;
    align-content: start;
    gap: var(--space-4);
  }

  /* Rank crest: framed slot, like a character portrait */
  .identity-head {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .crest {
    --frame-color: var(--color-border-accent);
    --frame-drop: transparent;
    display: grid;
    flex: none;
    place-items: center;
    margin: var(--pixel-thin);
    padding: var(--space-2);
    background: var(--color-bg);
    color: var(--color-accent-primary);
  }

  .identity-name {
    display: grid;
    gap: var(--space-1);
    min-width: 0;
  }

  .char-title {
    font-family: var(--font-heading);
    font-size: var(--text-h2);
    font-weight: 400;
    font-synthesis: none;
    letter-spacing: 0.01em;
  }

  .char-xp-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-accent-primary);
  }

  .char-xp {
    color: var(--color-text-muted);
  }

  .card-title {
    font-size: var(--text-lg);
  }

  .attribute-list {
    display: grid;
    gap: var(--space-4);
  }

  .character-note {
    max-width: 44rem;
    margin-top: var(--space-5);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
</style>
