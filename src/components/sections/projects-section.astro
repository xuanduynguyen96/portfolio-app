---
import { getCollection } from 'astro:content';
import SectionHeading from '../section-heading.astro';
import ProjectCard from '../project-card.astro';
import { loadCareerState } from '../../utils/career-rpg/load-career-state';

// Card order = quest order (boss, featured, order, title: see sortQuests).
const { quests } = await loadCareerState();
const rank = new Map(quests.map((quest, index) => [quest.id, index]));
const questXp = new Map(quests.map((quest) => [quest.id, quest.xp]));
const projects = (await getCollection('projects')).sort((a, b) => (rank.get(a.id) ?? 0) - (rank.get(b.id) ?? 0));
---

<section id="projects" class="section" aria-labelledby="projects-title">
  <div class="container">
    <SectionHeading index={4} label="Projects" title="Selected work" id="projects-title" />
    <div class="projects-grid">
      {projects.map((project) => <ProjectCard project={project} questXp={questXp.get(project.id) ?? 0} />)}
    </div>
  </div>
</section>

<style>
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-5);
  }

  /* Boss battle spans two columns once two fit. */
  @media (min-width: 56rem) {
    .projects-grid > :global([data-boss]) {
      grid-column: span 2;
    }
  }
</style>
