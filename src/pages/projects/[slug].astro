---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/base-layout.astro';
import NeonButton from '../../components/neon-button.astro';
import TagList from '../../components/tag-list.astro';
import { siteConfig } from '../../data/site-config';
import { withBasePath } from '../../utils/with-base-path';
import { getEvidenceLink } from '../../utils/career-rpg/evidence-links';
import { loadCareerState } from '../../utils/career-rpg/load-career-state';
import type { ScoredQuest } from '../../utils/career-rpg/career-types';
import BossBattlePanel from '../../components/career-rpg/boss-battle-panel.astro';

// One page per quest (public repo picked by the career engine); the override adds a case study.
export const getStaticPaths = (async () => {
  const { quests } = await loadCareerState();
  return quests.map((quest) => ({ params: { slug: quest.id }, props: { quest } }));
}) satisfies GetStaticPaths;

interface Props {
  quest: ScoredQuest;
}

const { quest } = Astro.props;
const { id, title, summary, tags, evidence, repoMetrics } = quest;
const override = (await getCollection('projects')).find((entry) => entry.id === id);
const cover = override?.data.cover;
const coverAlt = override?.data.coverAlt ?? '';
const Content = override && override.body?.trim() ? (await render(override)).Content : undefined;
const repoUrl = getEvidenceLink(evidence, 'repo');
const demoUrl = getEvidenceLink(evidence, 'demo');
const facts = repoMetrics.map((metric) => `${metric.label}: ${metric.value}${metric.unit ? ` ${metric.unit}` : ''}`);
---

<BaseLayout title={`${title} | ${siteConfig.name}`} description={summary}>
  <article class="project-detail container" aria-labelledby="project-title">
    <a class="back-link hud-text" href={withBasePath('/#projects')}>← All projects</a>
    <header class="project-header">
      <p class="eyebrow">{Content ? 'Case study' : 'Quest'}</p>
      <h1 id="project-title" transition:name={`project-title-${id}`}>{title}</h1>
      <p class="project-summary">{summary}</p>
      <TagList tags={tags} label="Technologies" />
      <div class="project-actions">
        {repoUrl && <NeonButton href={repoUrl} external>View code ↗</NeonButton>}
        {demoUrl && <NeonButton href={demoUrl} variant="ghost" external>Live demo ↗</NeonButton>}
      </div>
    </header>
    <BossBattlePanel quest={quest} />
    {
      cover && (
        <Image
          class="project-cover glass"
          src={cover}
          alt={coverAlt}
          width={1200}
          height={675}
          loading="eager"
          transition:name={`project-cover-${id}`}
        />
      )
    }
    <div class="prose">
      {
        Content ? (
          <Content />
        ) : (
          <>
            <h2>About this repo</h2>
            <p>
              Derived from the public GitHub repository <code>{quest.repo}</code>. No written case study yet: the quest
              is scored from repository facts only.
            </p>
            {facts.length > 0 && (
              <ul>
                {facts.map((fact) => (
                  <li>{fact}</li>
                ))}
              </ul>
            )}
          </>
        )
      }
    </div>
  </article>
</BaseLayout>

<style>
  .project-detail {
    display: grid;
    gap: var(--space-7);
    padding-block: var(--space-7) var(--space-section);
  }

  .back-link {
    width: fit-content;
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .back-link:hover {
    text-decoration: underline;
  }

  .project-header {
    display: grid;
    gap: var(--space-4);
  }

  h1 {
    font-size: clamp(2.25rem, 4vw + 1rem, 4rem);
  }

  .project-summary {
    max-width: 44rem;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  .project-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .project-cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    padding: 0;
  }

  .prose {
    display: grid;
    gap: var(--space-4);
    max-width: 44rem;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  .prose :global(h2) {
    margin-top: var(--space-5);
    color: var(--color-text);
    font-size: var(--text-h3);
  }

  .prose :global(ul) {
    padding-left: var(--space-5);
  }

  .prose :global(code) {
    color: var(--color-accent-primary);
    font-size: 0.9em;
  }
</style>
