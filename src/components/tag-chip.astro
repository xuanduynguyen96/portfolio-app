---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<li class="tag-chip pixel-frame">{label}</li>

<style>
  .tag-chip {
    margin: var(--pixel-thin);
    padding: var(--space-1) var(--space-3);
    background: var(--color-surface);
    color: var(--color-text-muted);
    font-family: var(--font-hud);
    font-size: var(--text-hud);
    letter-spacing: var(--tracking-hud);
    --frame-color: var(--color-border);
    --frame-drop: transparent;
    transition: color var(--duration-base) var(--ease-out-expo);
  }

  .tag-chip:hover {
    --frame-color: var(--color-frame-hover);
    color: var(--color-text);
  }
</style>
