---
import PixelIcon from './pixel-icon.astro';
import { PIXEL_ICON_NAMES } from '../data/pixel-icons';
---

<ul class="icon-gallery" role="list" aria-label="Pixel icon set">
  {
    PIXEL_ICON_NAMES.map((name) => (
      <li class="icon-tile pixel-frame">
        <PixelIcon name={name} size={32} />
        <code>{name}</code>
      </li>
    ))
  }
</ul>

<style>
  .icon-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 8rem), 1fr));
    gap: var(--space-4);
  }

  .icon-tile {
    display: grid;
    justify-items: center;
    gap: var(--space-2);
    margin: var(--pixel-thin);
    padding: var(--space-4) var(--space-2);
    background: var(--color-surface);
    color: var(--color-accent-primary);
  }

  .icon-tile code {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
</style>
