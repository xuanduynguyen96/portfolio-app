---
// One radio of the class/job switcher. The native input covers the label (whole box is the target);
// the checked state is a thicker frame + filled marker, so it never relies on colour alone.
interface Props {
  name: string;
  value: string;
  label: string;
  /** Short explanation under the label (job = what the archetype means). */
  hint?: string;
  /** This option is the one the public GitHub data suggests. */
  isPick?: boolean;
}

const { name, value, label, hint, isPick = false } = Astro.props;
---

<label class="switcher-option pixel-frame">
  <input type="radio" {name} {value} autocomplete="off" />
  <span class="switcher-marker" aria-hidden="true"></span>
  <span class="switcher-text">
    <span class="switcher-label">{label}</span>
    {hint && <span class="switcher-hint">{hint}</span>}
    {isPick && <span class="switcher-pick-tag hud-text">GitHub pick</span>}
  </span>
</label>

<style>
  .switcher-option {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    min-block-size: 2.75rem; /* 44px target */
    margin: var(--pixel-thin);
    padding: var(--space-2) var(--space-3);
    background: var(--color-surface);
    cursor: pointer;
  }

  .switcher-option:hover {
    --frame-color: var(--color-frame-hover);
  }

  .switcher-option input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .switcher-marker {
    flex: none;
    inline-size: calc(2 * var(--pixel));
    block-size: calc(2 * var(--pixel));
    margin-block-start: calc(0.5 * var(--pixel));
    border: var(--pixel-thin) solid var(--color-accent-primary);
  }

  .switcher-option:has(input:checked) {
    --frame-width: var(--pixel);
    --frame-color: var(--color-accent-primary);
    background: var(--color-surface-hover);
  }

  .switcher-option:has(input:checked) .switcher-marker {
    background: var(--color-accent-primary);
  }

  .switcher-option:has(input:focus-visible) {
    outline: 2px solid var(--color-focus);
    outline-offset: calc(var(--frame-width) + 2px);
  }

  .switcher-text {
    display: grid;
    gap: var(--pixel-thin);
    min-inline-size: 0;
  }

  .switcher-label {
    color: var(--color-text);
    font-weight: 600;
  }

  .switcher-hint {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .switcher-pick-tag {
    color: var(--color-accent-primary);
    font-size: var(--text-hud);
  }
</style>
