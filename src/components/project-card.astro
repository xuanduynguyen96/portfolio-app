---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import TagList from './tag-list.astro';
import QuestTierBadge from './career-rpg/quest-tier-badge.astro';
import PixelIcon from './pixel-icon.astro';
import { withBasePath } from '../utils/with-base-path';
import { getEvidenceLink } from '../utils/career-rpg/evidence-links';

interface Props {
  project: CollectionEntry<'projects'>;
  /** XP this quest earned at build time (0 when unverified). */
  questXp: number;
}

const { project, questXp } = Astro.props;
const { title, summary, tags, cover, coverAlt, evidence, difficulty, isBoss } = project.data;
const repoUrl = getEvidenceLink(evidence, 'repo');
const demoUrl = getEvidenceLink(evidence, 'demo');
const detailHref = withBasePath(`/projects/${project.id}/`);
---

<article class="glass project-card" data-spotlight data-reveal data-boss={isBoss ? '' : undefined}>
  {
    cover && (
      <Image
        class="project-cover"
        src={cover}
        alt={coverAlt}
        width={600}
        height={338}
        loading="lazy"
        transition:name={`project-cover-${project.id}`}
      />
    )
  }
  <div class="project-body">
    <p class="quest-meta">
      <QuestTierBadge difficulty={difficulty} isBoss={isBoss} />
      <span class:list={['quest-reward', { 'quest-reward--earned': questXp > 0 }]}>
        {questXp > 0 && <PixelIcon name="xp" />}
        <span class="quest-xp hud-text">{questXp > 0 ? `+${Math.round(questXp)} XP` : 'Unverified'}</span>
      </span>
    </p>
    <h3 transition:name={`project-title-${project.id}`}>
      <a href={detailHref}>{title}</a>
    </h3>
    <p class="project-summary">{summary}</p>
    <TagList tags={tags} label={`${title} technologies`} />
    <p class="project-links hud-text">
      <a href={detailHref} aria-label={`Read case study: ${title}`}>Case study →</a>
      {
        repoUrl && (
          <a href={repoUrl} target="_blank" rel="noopener noreferrer" aria-label={`${title} source code (opens in new tab)`}>
            Code ↗
          </a>
        )
      }
      {
        demoUrl && (
          <a href={demoUrl} target="_blank" rel="noopener noreferrer" aria-label={`${title} live demo (opens in new tab)`}>
            Live ↗
          </a>
        )
      }
    </p>
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  /* Boss: crimson frame (hover included) + one soft glow. The glow is a filter, never box-shadow:
     box-shadow draws the pixel frame (effects.css). */
  .project-card[data-boss],
  .project-card[data-boss]:hover {
    --frame-color: var(--color-accent-secondary);
  }

  .project-card[data-boss] {
    filter: drop-shadow(0 0 12px var(--color-glow-secondary));
  }

  .project-cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-bottom: var(--pixel) solid var(--frame-color); /* matches the card frame, incl. hover + boss */
  }

  .project-body {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-5);
  }

  .quest-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  .quest-reward {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--color-text-muted);
  }

  .quest-reward--earned {
    color: var(--color-accent-primary);
  }

  .quest-xp {
    font-size: var(--text-hud);
    letter-spacing: var(--tracking-hud);
  }

  h3 a {
    color: var(--color-text);
    text-decoration: none;
  }

  h3 a:hover {
    color: var(--color-accent-primary);
  }

  .project-summary {
    color: var(--color-text-muted);
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    font-size: var(--text-sm);
  }

  .project-links a {
    text-decoration: none;
  }

  .project-links a:hover {
    text-decoration: underline;
  }
</style>
