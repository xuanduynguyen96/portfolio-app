---
import GlassCard from '../glass-card.astro';
import PixelIcon from '../pixel-icon.astro';
import { formatMetricValue } from '../../utils/career-rpg/format-metric';
import type { Achievement } from '../../utils/career-rpg/career-types';
import { withBasePath } from '../../utils/with-base-path';

interface Props {
  achievement: Achievement;
}

const { achievement } = Astro.props;
---

<GlassCard as="li" class="achievement" data-reveal>
  <div class="achievement-head">
    <span class="achievement-icon"><PixelIcon name="achievement" size={32} /></span>
    {achievement.isSample && <p class="sample-tag pixel-frame hud-text">Sample</p>}
  </div>
  <p class="achievement-value">{formatMetricValue(achievement)}</p>
  <p class="achievement-label">{achievement.label}</p>
  <p class="achievement-quest hud-text">
    <a href={withBasePath(`/projects/${achievement.questId}/`)}>{achievement.questTitle} →</a>
  </p>
</GlassCard>

<style>
  .achievement {
    display: grid;
    align-content: start;
    gap: var(--space-2);
  }

  .achievement-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }

  .achievement-icon {
    display: inline-flex;
    color: var(--color-accent-primary);
  }

  .achievement-value {
    width: fit-content;
    color: var(--color-accent-primary);
    font-family: var(--font-hud);
    font-size: var(--text-h2);
    font-weight: 700;
    line-height: var(--leading-tight);
  }

  .achievement-quest {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  /* Crimson chip: "Sample" is text, the color only reinforces it. */
  .sample-tag {
    --frame-color: var(--color-accent-secondary);
    --frame-drop: transparent;
    margin: var(--pixel-thin);
    padding: 0 var(--space-2);
    background: var(--color-accent-secondary);
    color: var(--color-text-on-accent);
    font-size: var(--text-hud);
    font-weight: 700;
    letter-spacing: var(--tracking-hud);
    text-transform: uppercase;
  }
</style>
