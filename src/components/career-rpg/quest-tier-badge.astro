---
import type { QuestDifficulty } from '../../data/xp-rules';

interface Props {
  difficulty: QuestDifficulty;
  isBoss: boolean;
}

const { difficulty, isBoss } = Astro.props;
const tierLabel: Record<QuestDifficulty, string> = { side: 'Side quest', main: 'Main quest', raid: 'Raid' };
const label = isBoss ? `Boss · ${tierLabel[difficulty]}` : tierLabel[difficulty];
---

<span class:list={['quest-badge', 'mono', `quest-badge--${isBoss ? 'boss' : difficulty}`]}>{label}</span>

<style>
  .quest-badge {
    display: inline-block;
    width: fit-content;
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
  }

  .quest-badge--main {
    border-color: var(--color-accent-cyan);
    color: var(--color-accent-cyan);
  }

  .quest-badge--raid {
    border-color: var(--color-accent-magenta);
    color: var(--color-accent-magenta);
  }

  .quest-badge--boss {
    border-color: var(--color-accent-magenta);
    background: var(--color-accent-magenta);
    color: var(--color-text-on-accent);
    font-weight: 700;
  }
</style>
