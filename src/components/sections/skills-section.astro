---
import SectionHeading from '../section-heading.astro';
import GlassCard from '../glass-card.astro';
import SkillTreeNode from '../career-rpg/skill-tree-node.astro';
import { loadCareerState } from '../../utils/career-rpg/load-career-state';
import { xpRules } from '../../data/xp-rules';

const { skillTree, quests } = await loadCareerState();
const questTitles = Object.fromEntries(quests.map((quest) => [quest.id, quest.title]));
const unlocks = xpRules.skillEvidence.levelThresholds
  .map((threshold, index) => `level ${index + 1} at ${threshold}`)
  .join(', ');
---

<section id="skills" class="section" aria-labelledby="skills-title">
  <div class="container">
    <SectionHeading index={3} label="Skills" title="Skill tree" id="skills-title" />
    <p class="skills-legend">
      Skills level up only through evidence: linked work and verified projects, counted as pieces of evidence
      ({unlocks}). Branches also count their sub-skills' evidence.
    </p>
    <ul class="skill-tree-roots" role="list" aria-label="Skill tree">
      {
        skillTree.map((root) => (
          <GlassCard as="li" class="skill-root" data-reveal>
            <SkillTreeNode node={root} questTitles={questTitles} isRoot />
          </GlassCard>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .skills-legend {
    max-width: 44rem;
    margin-bottom: var(--space-6);
    color: var(--color-text-muted);
  }

  .skill-tree-roots {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    align-items: start;
    gap: var(--space-5);
  }

  .skill-root {
    padding: var(--space-5);
  }
</style>
